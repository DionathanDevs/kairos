    "kairos": "file:.."
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
