# ==========================================
# Kairos - Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to version control.
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/habits.db

# ==========================================
# Telegram Bot Integration (Sensitive)
# ==========================================
# Enable or disable the Telegram Bot module ('true' or 'false')
TELEGRAM_BOT_ENABLED=false

# Bot Token obtained from @BotFather on Telegram (kept strictly in env)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of authorized Telegram Chat IDs / User IDs allowed to create tasks
# Example: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# Operation mode: 'polling' (default, works locally/behind NAT) or 'webhook'
TELEGRAM_BOT_MODE=polling

# Polling interval in milliseconds (used when TELEGRAM_BOT_MODE=polling)
TELEGRAM_POLLING_INTERVAL_MS=2000

# Secret token to validate X-Telegram-Bot-Api-Secret-Token header (required when TELEGRAM_BOT_MODE=webhook)
TELEGRAM_WEBHOOK_SECRET=
